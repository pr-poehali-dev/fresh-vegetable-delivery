{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Missing name and phone",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Create order without user",
      "method": "POST",
      "path": "/",
      "body": {
        "name": "Тест",
        "phone": "+79001234567",
        "address": "ул. Тестовая, 1",
        "items": [{"name": "Помидоры", "quantity": 2, "price": 150}],
        "total_price": 300
      },
      "expectedStatus": 200
    },
    {
      "name": "GET история заказов без user_id",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400
    },
    {
      "name": "GET история заказов с user_id",
      "method": "GET",
      "path": "/?user_id=1",
      "expectedStatus": 200
    },
    {
      "name": "PUT без order_id",
      "method": "PUT",
      "path": "/",
      "body": {"user_id": 1},
      "expectedStatus": 400
    }
  ]
}